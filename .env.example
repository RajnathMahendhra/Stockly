# ==========================================
# Stockly Environment Variables Overview
# ==========================================

# Server (Express.js)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stockly?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173

# Frontend (Vite + React)
VITE_API_URL=http://localhost:5000/api

# Machine Learning Service (FastAPI)
ML_PORT=8000
ML_HOST=0.0.0.0
MODEL_DIR=app/data/saved_models
DATA_CACHE_DIR=app/data/cache
