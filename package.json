{
  "name": "stockly-root",
  "version": "1.0.0",
  "description": "Stockly: An AI-Driven Framework for Stock Market Analysis and Future Price Prediction",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:ml": "cd ml-service && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build:client": "cd client && npm run build",
    "start:server": "cd server && npm start",
    "test:server": "cd server && npm test",
    "test:ml": "cd ml-service && python -m unittest discover tests"
  },
  "keywords": [
    "stock-prediction",
    "machine-learning",
    "fintech",
    "mern-stack",
    "fastapi",
    "time-series"
  ],
  "author": "Stockly Academic Project Team",
  "license": "ISC"
}
